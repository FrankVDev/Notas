POSTGRES_DB=notas
POSTGRES_USER=notas
POSTGRES_PASSWORD=cambia_esta_clave
APP_TZ=America/Lima
WEB_PORT=8080

# Cuentas: false para que nadie más pueda registrarse (la primera cuenta siempre se puede crear)
ALLOW_SIGNUP=true

# Respaldo automático en la carpeta respaldos/
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14

# Cookies solo por https: poner true cuando la app se use con https (Caddy)
COOKIE_SECURE=false

# Servidor con proxy inverso Caddy (repositorio servidor-casa): descomentar.
# La app deja de publicar WEB_PORT y queda en http(s)://notas.home.arpa
#COMPOSE_FILE=docker-compose.yml:docker-compose.proxy.yml
